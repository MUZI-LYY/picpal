# 真实模型 Key（验收前提供；开发期可缺省，缺省时自动回退 Mock）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 地图服务 Key（供应商：高德）
MAP_API_KEY=
MAP_PROVIDER=amap
# 视觉审核模型（豆包，用于出片点图片质量审核）
VISION_API_KEY=
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-2-1-turbo-260628
# 匿名历史会话签名（至少 32 字节；生产环境必须由部署平台注入）
SESSION_SIGNING_SECRET=
# 本地纯 HTTP 调试时可临时设 false；生产必须为 true
SESSION_COOKIE_SECURE=true
# 内测邀请码：逗号分隔，如 code1,code2,code3（内测期必填；留空则拒绝所有邀请）
INVITE_CODES=
